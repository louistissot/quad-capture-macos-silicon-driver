<?xml version="1.0" encoding="utf-8"?>
<installer-gui-script minSpecVersion="2">
    <title>QUAD-CAPTURE Driver for macOS @VERSION@</title>
    <welcome file="welcome.html" mime-type="text/html"/>
    <license file="LICENSE.txt"/>
    <conclusion file="conclusion.html" mime-type="text/html"/>
    <options customize="never" require-scripts="true" hostArchitectures="arm64,x86_64"/>
    <domains enable_anywhere="false" enable_currentUserHome="false" enable_localSystem="true"/>
    <volume-check>
        <allowed-os-versions>
            <os-version min="12.0"/>
        </allowed-os-versions>
    </volume-check>
    <choices-outline>
        <line choice="default">
            <line choice="driver"/>
        </line>
    </choices-outline>
    <choice id="default"/>
    <choice id="driver" visible="false">
        <pkg-ref id="com.louistissot.quadcapture.driver"/>
    </choice>
    <pkg-ref id="com.louistissot.quadcapture.driver" version="@VERSION@" onConclusion="none">driver.pkg</pkg-ref>
</installer-gui-script>
